# Copy to .env. Do not commit secrets.
# YAML holds non-secret defaults. Environment variables override YAML.

SATQUERY_ENV=development
SATQUERY_DEVICE=cpu
SATQUERY_LOG_LEVEL=INFO
SATQUERY_MODEL_DIR=./models
SATQUERY_DATA_DIR=./data
SATQUERY_OUTPUT_DIR=./outputs

# Optional Hugging Face token for later specialist downloads (manual, never at startup).
# HF_TOKEN=
